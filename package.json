{
  "name": "memory-lab",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.ui.json",
    "build": "npm run typecheck && vite build && tsc -p tsconfig.server.json",
    "test:integration": "npm run build && node --test tests/integration.mjs",
    "start": "node --env-file=.env dist-server/server/server.js"
  },
  "dependencies": {
    "pg": "^8.13.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  }
}
